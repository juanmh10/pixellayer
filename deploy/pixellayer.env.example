# PixelLayer Production Environment Variables Template
# Copy this file to /etc/pixellayer/pixellayer.env on your Linux server

# Model settings
PIXELLAYER_DEFAULT_MODEL=birefnet-general
PIXELLAYER_MODEL_TTL=300
PIXELLAYER_MODELS_CACHE=/opt/pixellayer/models_cache

# Security & Workspaces
# Semicolon-separated list of authorized directories for image read/write
PIXELLAYER_ALLOWED_WORKSPACES=/opt/pixellayer/workspace

# Safety limits (Pixel Flood DoS mitigation)
PIXELLAYER_MAX_PIXELS=50000000

# Logging
PIXELLAYER_LOG_DIR=/opt/pixellayer/logs
PIXELLAYER_LOG_FILE=/opt/pixellayer/logs/pixellayer.log

# Compute Device (auto, cpu, cuda, mps)
PIXELLAYER_DEVICE=auto

# Server transport and binding
# Use 'stdio' when connecting via SSH bridge
# Use 'sse' or 'streamable-http' when running behind a reverse proxy
PIXELLAYER_TRANSPORT=sse
PIXELLAYER_HOST=127.0.0.1
PIXELLAYER_PORT=8000

# DNS Rebinding Protection and Allowed Host Headers
# Semicolon-separated list of host patterns (e.g. 127.0.0.1:*;localhost:*;mcp.yourdomain.com)
PIXELLAYER_ALLOWED_HOSTS=127.0.0.1:*;localhost:*;[::1]:*
PIXELLAYER_ENABLE_DNS_REBINDING=true
